# Copy to .env and fill in. NEVER commit the real .env.
# API key for the APILLMAdapter baseline.
# Use one of: OPENAI_API_KEY (OpenAI) or OPENROUTER_API_KEY (OpenRouter).
# OpenRouter gives access to many models at https://openrouter.ai
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Default endpoint for the HTTP adapter (/v1/systemone server).
INDICJEVBENCH_ENDPOINT=http://localhost:8000

# Where run results and raw logs are written (relative to repo root).
INDICJEVBENCH_RESULTS_DIR=results/v1
